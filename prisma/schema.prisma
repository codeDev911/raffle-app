// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  city      String?
  password  String
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  entries   Entry[]
  payments  Payment[]
  winners   Winner[]

  @@map("users")
}

model Raffle {
  id              String      @id @default(cuid())
  title           String
  description     String
  longDescription String?
  image           String?
  gallery         String[]
  price           Int // Price in PKR (paisa)
  realPrice       Int  @default(0)// Price in PKR (paisa)
  totalEntries    Int
  currentEntries  Int         @default(0)
  category        String
  featured        Boolean     @default(false)
  status          RaffleStatus @default(ACTIVE)
  startDate       DateTime    @default(now())
  endDate         DateTime
  specifications  String[]
  rules           String[]
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  entries Entry[]
  winners Winner[]

  @@map("raffles")
}

model Entry {
  id        String   @id @default(cuid())
  userId    String
  raffleId  String
  quantity  Int      @default(1)
  totalCost Int // Total cost in PKR (paisa)
  paymentId String?
  createdAt DateTime @default(now())

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  raffle  Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@map("entries")
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  amount        Int // Amount in PKR (paisa)
  currency      String        @default("PKR")
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  gatewayRef    String?       // Reference from payment gateway
  metadata      Json?         // Additional payment data
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries Entry[]

  @@map("payments")
}

model Winner {
  id          String   @id @default(cuid())
  userId      String
  raffleId    String
  prizeValue  Int // Prize value in PKR (paisa)
  testimonial String?
  proofImage  String?
  verified    Boolean  @default(false)
  featured    Boolean  @default(false)
  drawnAt     DateTime @default(now())
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@unique([userId, raffleId])
  @@map("winners")
}

enum Role {
  USER
  ADMIN
}

enum RaffleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  EASYPAISA
  JAZZCASH
  CARD
  NAYAPAY
  SAYAPAY
  MEZAN
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
}
