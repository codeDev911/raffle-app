// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  phone     String?
  city      String?
  password  String?
  role      Role     @default(USER)
  isActive  Boolean  @default(true)
  image     String?
  googleId  String?  @unique
  emailVerified DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  entries   Entry[]
  payments  Payment[]
  winners   Winner[]
  merchantStore MerchantStore?

  @@map("users")
}

model Raffle {
  id              String      @id @default(cuid())
  title           String
  description     String
  longDescription String?
  image           String?
  gallery         String[]
  price           Int // Price in PKR (paisa)
  realPrice       Int  @default(0)// Price in PKR (paisa)
  totalEntries    Int
  currentEntries  Int         @default(0)
  category        String
  featured        Boolean     @default(false)
  status          RaffleStatus @default(ACTIVE)
  startDate       DateTime    @default(now())
  endDate         DateTime
  specifications  String[]
  rules           String[]
  expenses        Json?       @default("[]")
  listingRequestId String?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  // Relations
  entries           Entry[]
  winners           Winner[]
  merchantCampaigns MerchantCampaign[]

  @@map("raffles")
}

model Entry {
  id        String   @id @default(cuid())
  userId    String
  raffleId  String
  quantity  Int      @default(1)
  totalCost Int // Total cost in PKR (paisa)
  paymentId String?
  createdAt DateTime @default(now())

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  raffle  Raffle   @relation(fields: [raffleId], references: [id], onDelete: Cascade)
  payment Payment? @relation(fields: [paymentId], references: [id])

  @@map("entries")
}

model Payment {
  id            String        @id @default(cuid())
  userId        String
  amount        Int // Amount in PKR (paisa)
  currency      String        @default("PKR")
  method        PaymentMethod
  status        PaymentStatus @default(PENDING)
  transactionId String?       @unique
  gatewayRef    String?       // Reference from payment gateway
  metadata      Json?         // Additional payment data
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  entries Entry[]

  @@index([gatewayRef]) // gateway callbacks resolve a payment from its tracker/reference
  @@map("payments")
}

model Winner {
  id          String   @id @default(cuid())
  userId      String
  raffleId    String
  prizeValue  Int // Prize value in PKR (paisa)
  testimonial String?
  proofImage  String?
  verified    Boolean  @default(false)
  featured    Boolean  @default(false)
  drawnAt     DateTime @default(now())
  deliveredAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  raffle Raffle @relation(fields: [raffleId], references: [id], onDelete: Cascade)

  @@unique([userId, raffleId])
  @@map("winners")
}

enum Role {
  USER
  ADMIN
  MERCHANT
}

enum RaffleStatus {
  DRAFT
  ACTIVE
  COMPLETED
  CANCELLED
}

enum PaymentMethod {
  EASYPAISA
  JAZZCASH
  CARD
  NAYAPAY
  SAYAPAY
  MEZAN
  RAAST
  IBFT
  SADAPAY
  SAFEPAY
}

enum PaymentStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  CANCELLED
  // Money returned to the payer: the raffle entry behind it is withdrawn.
  REFUNDED
}

model ProductListingRequest {
  id           String        @id @default(cuid())
  productType  String
  productName  String
  description  String
  phone        String
  email        String
  fullNameCnic String
  cnicNumber   String?
  city         String?
  marketPrice  Int           // Market price in PKR
  ticketPrice  Int           // Ticket price in PKR
  totalTickets Int
  totalRevenue Int           // ticketPrice * totalTickets
  platformFee  Int           // 8% platform fee
  sellerPayout Int           // totalRevenue - platformFee
  condition    String?
  images       String[]      @default([])
  status       ListingStatus @default(PENDING)
  adminNotes   String?
  secureToken  String?
  raffleId     String?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@map("product_listing_requests")
}

enum ListingStatus {
  PENDING
  UNDER_REVIEW
  APPROVED
  REJECTED
}

// ─────────────────────────────────────────────────────────────
// Merchant Connect: Shopify / independent store lucky draw engine
// All money fields on merchant models are whole PKR (not paisa).
// ─────────────────────────────────────────────────────────────

model MerchantStore {
  id            String              @id @default(cuid())
  name          String
  storeUrl      String              @unique // normalized shop domain, e.g. mystore.myshopify.com
  platform      String              @default("SHOPIFY")
  apiKeyHash    String              @unique // sha256 of the merchant API key (raw key is shown once)
  apiKeyPrefix  String              // first characters of the key, for display only
  webhookSecret String              // HMAC signing secret used to verify incoming webhooks
  contactEmail  String
  contactPhone  String
  payoutDetails String?
  /** Square logo the merchant supplies, shown on the public raffle page next to their store name. */
  logoUrl       String?
  status        MerchantStoreStatus @default(ACTIVE)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt

  ownerId       String?             @unique // User who owns this merchant account (email/password or Google)
  owner         User?               @relation(fields: [ownerId], references: [id], onDelete: SetNull)

  // Shopify one-click connect (OAuth app install). The access token is the offline token
  // Shopify issues for this shop; it is used to register webhooks and the storefront widget.
  shopifyAccessToken   String?
  shopifyScope         String?
  shopifyConnectedAt   DateTime?
  shopifyWebhooksReady Boolean   @default(false) // webhooks + script tag registered
  shopifyScriptTagId   String?

  // Post-signup onboarding (welcome wizard + store intake form).
  onboardingStep        String    @default("WELCOME")
  onboardingCompletedAt DateTime?
  tallySubmissionId     String?
  // Answers to the six intake questions, keyed by question (see lib/merchants/intake.ts).
  intakeAnswers         Json?
  intakeSubmittedAt     DateTime?

  campaigns MerchantCampaign[]
  entries   MerchantEntry[]
  invoices  MerchantInvoice[] 
  // Credits and payout requests raised by returns, cancellations and refunds.
  refunds   MerchantRefundRequest[]

  @@map("merchant_stores")
}

model MerchantCampaign {
  id             String                 @id @default(cuid())
  storeId        String
  raffleId       String?
  title          String
  ruleType       MerchantRuleType       @default(MIN_QUANTITY)
  minQuantity    Int?
  minAmount      Int? // PKR
  productFilters String[]               @default([]) // SKU / product id / title keyword restrictions
  ticketPrice    Int // PKR billed to merchant per issued entry
  maxEntries     Int? // null = continuous campaign
  currentEntries Int                    @default(0) // live (non-test, non-cancelled) entries
  status         MerchantCampaignStatus @default(ACTIVE)
  startDate      DateTime               @default(now())
  endDate        DateTime
  winnerEntryId  String?
  drawnAt        DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  store    MerchantStore     @relation(fields: [storeId], references: [id], onDelete: Cascade)
  raffle   Raffle?           @relation(fields: [raffleId], references: [id], onDelete: SetNull)
  entries  MerchantEntry[]
  invoices MerchantInvoice[]
  refunds  MerchantRefundRequest[]

  @@index([storeId, status])
  @@map("merchant_campaigns")
}

model MerchantEntry {
  id              String              @id @default(cuid())
  campaignId      String
  storeId         String
  invoiceId       String?
  shopifyOrderId  String
  orderName       String? // human order number, e.g. #1042
  customerName    String
  customerEmail   String?
  customerPhone   String?
  customerCity    String? // shipping city, also written to the customer account's location
  phoneNormalized String? // digits-only 92XXXXXXXXXX for lookups
  ticketNumber    String              @unique
  orderAmount     Int // PKR (qualifying subtotal)
  itemCount       Int
  /** Browser nonce stamped on the Shopify cart, so the shopper's own browser can claim the popup. */
  claimToken      String?
  isTest          Boolean             @default(false) // minted by the dashboard simulator; never billed or drawn
  status          MerchantEntryStatus @default(ISSUED)
  cancelledReason String?
  // Live card checkout (Safepay) for this ticket. The session lives here rather than on a Payment
  // row, so an abandoned checkout leaves no payment behind: the ledger row is written the moment
  // the money is captured, never when the page is merely opened.
  gatewayRef       String? // tracker of the open session
  gatewayAmount    Int? // paisa we asked for — the figure a capture must match
  checkoutUrl      String? // same session, for re-opening it while it is alive
  gatewayStartedAt DateTime? // when the session opened; its age decides when we release the ticket
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  campaign MerchantCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  store    MerchantStore    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  invoice  MerchantInvoice? @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  // One request per ticket: the void itself is the guard against a duplicate credit.
  refund   MerchantRefundRequest?

  @@unique([campaignId, shopifyOrderId])
  @@index([storeId, status])
  @@index([phoneNormalized])
  @@index([shopifyOrderId])
  @@index([claimToken])
  // Callbacks and webhooks resolve a ticket session by its tracker.
  @@index([gatewayRef])
  @@map("merchant_entries")
}

model MerchantInvoice {
  id             String                 @id @default(cuid())
  campaignId     String
  storeId        String
  invoiceNumber  String                 @unique
  totalEntries   Int
  unitPrice      Int // PKR per entry at time of invoicing
  amountDue      Int // PKR
  // Credits from voided tickets of earlier batches, deducted when this invoice was raised. amountDue
  // is already net of it; this is kept so the merchant can see what was offset and why.
  creditApplied  Int   @default(0) // PKR
  paymentMethod  MerchantPaymentMethod?
  paymentProof   String? // receipt screenshot URL
  transactionRef String?
  adminNotes     String?
  status         MerchantInvoiceStatus  @default(PENDING)
  submittedAt    DateTime?
  paidAt         DateTime?
  // Hosted checkout (Safepay): the tracker identifies the session, the amount is what we asked
  // for in paisa, so a callback can verify the exact figure before anything is confirmed.
  gatewayRef     String?
  gatewayAmount  Int?
  checkoutUrl    String?
  // When the batch session opened. Its age — not the invoice's own age — decides when the
  // checkout stops being payable, so paying an old invoice still gets a usable session.
  gatewayStartedAt DateTime?
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  campaign MerchantCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  store    MerchantStore    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  entries  MerchantEntry[]
  // The batch a refunded ticket was billed on (RefundedBatch) and the batch a credit was spent on
  // (CreditedBatch). Both point at MerchantRefundRequest, so the relations are named.
  credits    MerchantRefundRequest[] @relation("RefundedBatch")
  creditRefs MerchantRefundRequest[] @relation("CreditedBatch")

  @@index([storeId, status])
  // Every callback/webhook resolves a session by its tracker.
  @@index([gatewayRef])
  @@map("merchant_invoices")
}

enum MerchantStoreStatus {
  ACTIVE
  PAUSED
}

enum MerchantRuleType {
  ALL_ORDERS
  MIN_QUANTITY
  MIN_AMOUNT
  MIN_QUANTITY_AND_AMOUNT
}

enum MerchantCampaignStatus {
  ACTIVE
  PAUSED
  PENDING_INVOICE
  DRAW_READY
  COMPLETED
}

enum MerchantEntryStatus {
  ISSUED
  INVOICED
  PAID
  CANCELLED
}

enum MerchantInvoiceStatus {
  PENDING
  UNDER_REVIEW
  PAID
}

enum MerchantPaymentMethod {
  RAAST
  IBFT
  NAYAPAY
  SADAPAY
  JAZZCASH
  EASYPAISA
  CARD
  SAFEPAY
}

/** Who raised the refund: Shopify told us, the merchant asked, or staff corrected it. */
enum MerchantRefundSource {
  WEBHOOK
  MERCHANT
  ADMIN
}

/** Where the money goes: offset the next batch, or be transferred out (staff approves payouts). */
enum MerchantRefundSettlement {
  CREDIT
  PAYOUT
}

enum MerchantRefundStatus {
  // Raised and waiting for staff because it asks for a cash payout.
  REQUESTED
  // Approved by staff, not transferred yet.
  APPROVED
  // Transferred to the merchant's payout details.
  PAID
  // Staff said no, with a reason the merchant can read.
  REJECTED
  // Applied against an invoice — no human needed.
  CREDITED
}

// A ticket that came back after its batch was billed: the entry is void, and this row is the
// merchant's money trail. Timestamps are split deliberately — Shopify's own event time, the moment
// our webhook received it, and the moment PakRaffle acted — so "nothing happened" is never the answer.
model MerchantRefundRequest {
  id             String                  @id @default(cuid())
  storeId        String
  campaignId     String
  entryId        String                  @unique
  ticketNumber   String
  shopifyOrderId String
  orderName      String?
  invoiceId      String?
  creditInvoiceId String?

  grossAmount  Int // PKR billed for this ticket
  gatewayCost  Int // PKR already paid to the card/wallet processor (2.9% + Rs 30)
  netAmount    Int // PKR owed back to the merchant

  reason       String
  note         String?
  source       MerchantRefundSource
  settlement   MerchantRefundSettlement @default(CREDIT)
  status       MerchantRefundStatus     @default(CREDITED)
  triggerTopic String? // refunds/create, orders/updated, orders/cancelled, or manual

  // When it happened, when we heard, when we acted — visible to the merchant and to staff.
  shopifyEventAt DateTime?
  receivedAt     DateTime              @default(now())
  actionedAt     DateTime?
  decidedAt      DateTime?
  decidedBy      String?
  settledAt      DateTime?
  // Append-only, human-readable trail rendered as the timeline: [{ at, kind, label, detail }]
  events         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  store        MerchantStore    @relation(fields: [storeId], references: [id], onDelete: Cascade)
  campaign     MerchantCampaign @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  entry        MerchantEntry    @relation(fields: [entryId], references: [id], onDelete: Cascade)
  invoice      MerchantInvoice? @relation("RefundedBatch", fields: [invoiceId], references: [id], onDelete: SetNull)
  creditInvoice MerchantInvoice? @relation("CreditedBatch", fields: [creditInvoiceId], references: [id], onDelete: SetNull)

  @@index([storeId, status])
  @@index([storeId, settlement])
  @@map("merchant_refund_requests")
}
